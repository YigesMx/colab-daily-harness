# Paths are anchored at PROJECT_ROOT, not the invoking working directory.
COLAB_STORAGE_DIR=state/storage
COLAB_BACKUP_DIR=state/backups
COLAB_SITE_DIR=.local/site
COLAB_WORKING_DIR=working_tmp

# Source integration (optional when that source is disabled).
JIQIZHIXIN_RSS_TOKEN=

# Formal VitePress deployment. Keep real values only in ignored .env.
COLAB_SITE_REMOTE=origin
COLAB_SITE_BRANCH=main
COLAB_SITE_BASE=/
COLAB_SITE_URL=https://daily.example.org/
COLAB_DAILY_DEPLOY_KEY=.repo_private_key

# Optional post-Released notification. Never place this value in prompts/receipts.
FEISHU_WEBHOOK_URL=
